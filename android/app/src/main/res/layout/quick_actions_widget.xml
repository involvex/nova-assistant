<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:padding="8dp"
    android:columnCount="2"
    android:rowCount="2"
    android:alignmentMode="alignBounds">

    <!-- Row 1, Col 1: New Chat -->
    <LinearLayout
        android:id="@+id/btn_new_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/action_new_chat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_new_chat"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 1, Col 2: Voice -->
    <LinearLayout
        android:id="@+id/btn_voice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/action_voice_input" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_voice_input"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 2, Col 1: Screenshot -->
    <LinearLayout
        android:id="@+id/btn_screenshot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/action_screenshot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_screenshot"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 2, Col 2: Quick Ask -->
    <LinearLayout
        android:id="@+id/btn_quick_ask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/widget_primary"
            android:contentDescription="@string/action_quick_ask" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_quick_ask"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

</GridLayout>