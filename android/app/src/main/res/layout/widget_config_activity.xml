<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/widget_primary"
            android:contentDescription="Widget icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Quick Actions Widget"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select which actions to show:"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <CheckBox
            android:id="@+id/check_new_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/widget_primary"
            android:checked="true"
            android:padding="12dp"
            android:text="New Chat"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@color/widget_text_secondary" />

        <CheckBox
            android:id="@+id/check_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/widget_primary"
            android:checked="true"
            android:padding="12dp"
            android:text="Voice Input"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@color/widget_text_secondary" />

        <CheckBox
            android:id="@+id/check_screenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/widget_primary"
            android:checked="true"
            android:padding="12dp"
            android:text="Screenshot"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@color/widget_text_secondary" />

        <CheckBox
            android:id="@+id/check_quick_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/widget_primary"
            android:checked="true"
            android:padding="12dp"
            android:text="Quick Ask"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_button_bg"
            android:text="Cancel"
            android:textColor="@color/widget_text_secondary" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/widget_primary_button_bg"
            android:text="Save"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>